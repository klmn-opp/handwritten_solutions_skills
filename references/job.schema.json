{
  "$defs": {
    "Background": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "plain",
          "enum": [
            "plain",
            "lined",
            "grid",
            "dots",
            "image",
            "pdf"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "fit": {
          "default": "contain",
          "enum": [
            "contain",
            "cover",
            "stretch"
          ],
          "title": "Fit",
          "type": "string"
        }
      },
      "title": "Background",
      "type": "object"
    },
    "Equality": {
      "additionalProperties": false,
      "properties": {
        "lhs": {
          "minLength": 1,
          "title": "Lhs",
          "type": "string"
        },
        "rhs": {
          "minLength": 1,
          "title": "Rhs",
          "type": "string"
        }
      },
      "required": [
        "lhs",
        "rhs"
      ],
      "title": "Equality",
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "number": {
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "solution": {
          "minLength": 1,
          "title": "Solution",
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/Background"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "number",
        "sources",
        "statement",
        "solution"
      ],
      "title": "Problem",
      "type": "object"
    },
    "RenderConfig": {
      "additionalProperties": false,
      "properties": {
        "dpi": {
          "default": 150,
          "maximum": 300,
          "minimum": 72,
          "title": "Dpi",
          "type": "integer"
        },
        "page_width_mm": {
          "default": 210,
          "maximum": 300,
          "minimum": 100,
          "title": "Page Width Mm",
          "type": "number"
        },
        "page_height_mm": {
          "default": 297,
          "maximum": 400,
          "minimum": 100,
          "title": "Page Height Mm",
          "type": "number"
        },
        "margin_mm": {
          "default": 18,
          "maximum": 50,
          "minimum": 5,
          "title": "Margin Mm",
          "type": "number"
        },
        "font_size_pt": {
          "default": 13,
          "maximum": 24,
          "minimum": 8,
          "title": "Font Size Pt",
          "type": "number"
        },
        "line_spacing": {
          "default": 1.6,
          "maximum": 2.5,
          "minimum": 1.1,
          "title": "Line Spacing",
          "type": "number"
        },
        "seed": {
          "default": 42,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "paper": {
          "default": "plain",
          "enum": [
            "plain",
            "lined",
            "grid",
            "dots"
          ],
          "title": "Paper",
          "type": "string"
        },
        "ink": {
          "default": "#202838",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Ink",
          "type": "string"
        }
      },
      "title": "RenderConfig",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "Source",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "inconclusive",
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Equality"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "generated_by": {
      "minLength": 1,
      "title": "Generated By",
      "type": "string"
    },
    "language": {
      "default": "en",
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile"
    },
    "profile_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Sha256"
    },
    "background": {
      "anyOf": [
        {
          "$ref": "#/$defs/Background"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "render": {
      "$ref": "#/$defs/RenderConfig"
    },
    "problems": {
      "items": {
        "$ref": "#/$defs/Problem"
      },
      "minItems": 1,
      "title": "Problems",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "problems"
  ],
  "title": "Job",
  "type": "object"
}
